#!/usr/bin/env bash
set -euo pipefail

SOURCE_DIR="${QWEN3_TTS_SOURCE:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
DATA_DIR="${QWEN3_TTS_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/qwen3-tts}"
ENGINE="${QWEN_CONTAINER_ENGINE:-docker}"
BACKEND="${QWEN_BACKEND:-vulkan}"
PORT="${QWEN_PORT:-7860}"
BIND_ADDRESS="${QWEN_BIND_ADDRESS:-127.0.0.1}"
CONTAINER_NAME="${QWEN_CONTAINER_NAME:-qwen3-tts-server}"
RESTART_POLICY="${QWEN_RESTART_POLICY:-no}"

IMAGE_REGISTRY="ghcr.io/serveurpersocom/qwentts.cpp"
IMAGE_TAG="${QWEN_IMAGE_TAG:-71ad93d591a2811f35db77e27c02acba091c9e9b}"

MODEL_REPO="https://huggingface.co/Serveurperso/Qwen3-TTS-GGUF/resolve/b7ee2e8c7459c3bea99da23e3d178125a7d1713c"
TALKER_MODEL="${QWEN_TALKER_MODEL:-qwen-talker-0.6b-base-Q8_0.gguf}"
CODEC_MODEL="${QWEN_CODEC_MODEL:-qwen-tokenizer-12hz-Q8_0.gguf}"

die() {
    printf 'qwen3-tts: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: qwen3-tts COMMAND [ARGS]

  pull [vulkan|cuda|cpu]      Pull the pinned upstream GGML server image
  serve [vulkan|cuda|cpu]     Run in the foreground (for systemd)
  start [vulkan|cuda|cpu]     Run in the background without boot persistence
  stop                        Stop the server
  restart [vulkan|cuda|cpu]   Restart the server
  status                      Show container and API status
  logs [-f]                   Show server logs
  doctor [vulkan|cuda|cpu]    Pre-flight checks (host devices, image, models)
  install-user [BACKEND]      Install a disabled systemd user service
  uninstall-user              Remove the systemd user service
  voice COMMAND ...           Add, list, rename, remove, or export voices

Backends: vulkan (AMD/Intel/NVIDIA via render nodes), cuda, cpu.
The vulkan backend only needs /dev/dri; compute stays off the graphics
queue by default so the desktop session is never the failure surface.

Examples:
  qwen3-tts doctor vulkan
  qwen3-tts voice add narrator interview.mp4 --start 01:12 --text "Exact words spoken"
  qwen3-tts voice set-default narrator
  qwen3-tts install-user vulkan
  systemctl --user start qwen3-tts.service
EOF
}

valid_backend() {
    case "$1" in
        vulkan|cuda|cpu) return 0 ;;
        *) return 1 ;;
    esac
}

require_backend() {
    valid_backend "$1" || die "unknown backend '$1'; expected vulkan, cuda, or cpu"
}

image_for() {
    local backend="$1"
    printf '%s\n' "${QWEN_IMAGE:-${IMAGE_REGISTRY}:${backend}-${IMAGE_TAG}}"
}

prepare_data() {
    mkdir -p "$DATA_DIR/voices" "$DATA_DIR/models"
}

model_sha256() {
    case "$1" in
        qwen-talker-0.6b-base-Q8_0.gguf)
            printf '%s\n' d54dbaf10591421fa764ed630d764efa717ae40cd959bd48c66d4eb1af226426 ;;
        qwen-tokenizer-12hz-Q8_0.gguf)
            printf '%s\n' 1883beeed99348fc35e23dd225e9082f93f6f8c109330a33d935baa8acdbfd94 ;;
        *) return 1 ;;
    esac
}

verify_model() {
    local path="$1"
    local expected
    if ! expected="$(model_sha256 "$(basename "$path")")"; then
        [[ -s "$path" ]] || return 1
        return 0
    fi
    printf '%s  %s\n' "$expected" "$path" | sha256sum --check --status
}

download_model() {
    local name="$1"
    local destination="$DATA_DIR/models/$name"
    if [[ -f "$destination" ]] && verify_model "$destination"; then
        return 0
    fi
    local partial="${destination}.part"
    printf 'downloading %s\n' "$name"
    curl --fail --location --progress-bar --output "$partial" "$MODEL_REPO/$name"
    mv "$partial" "$destination"
    verify_model "$destination" || {
        rm -f "$destination"
        die "sha256 mismatch for $name; download was corrupt"
    }
}

ensure_models() {
    download_model "$TALKER_MODEL"
    download_model "$CODEC_MODEL"
}

ensure_image() {
    local image
    image="$(image_for "$1")"
    "$ENGINE" image inspect "$image" >/dev/null 2>&1 && return 0
    "$ENGINE" pull "$image"
}

device_args() {
    local backend="$1"
    case "$backend" in
        vulkan)
            [[ -d /dev/dri ]] || die "/dev/dri is missing; load/install the AMDGPU host driver"
            [[ -e /dev/dri/renderD128 ]] || die "/dev/dri/renderD128 is missing; no render node available"
            printf '%s\n' --device=/dev/dri \
                --group-add="$(stat -c %g /dev/dri/renderD128)"
            ;;
        cuda)
            printf '%s\n' --gpus=all
            ;;
        cpu) ;;
        *) die "unknown backend '$backend'" ;;
    esac
}

environment_args() {
    local variable
    for variable in TTS_LANG MODEL_ALIAS WARMUP_VOICE WARMUP_MAX_NEW_TOKENS \
        MAX_BATCH MAX_PREFILL_TOKENS CODEC_CHUNK_DUR NO_FA CLAMP_FP16 \
        GGML_VK_ALLOW_GRAPHICS_QUEUE GGML_VK_ASYNC_USE_TRANSFER_QUEUE \
        GGML_VK_SERIALIZE_SUBMISSIONS GGML_VK_DISABLE_F16 RADV_PERFTEST; do
        if [[ -n "${!variable:-}" ]]; then
            printf '%s\n' --env "$variable=${!variable}"
        fi
    done
}

container_args() {
    local backend="$1"
    printf '%s\n' \
        --name "$CONTAINER_NAME" \
        --init \
        --publish "$BIND_ADDRESS:$PORT:7860" \
        --volume "$DATA_DIR/voices:/voices" \
        --volume "$DATA_DIR/models:/models" \
        --env MODEL_PATH="/models/$TALKER_MODEL" \
        --env CODEC_PATH="/models/$CODEC_MODEL" \
        --env PORT=7860 \
        --env HOST=0.0.0.0 \
        --env MODEL_ALIAS="${MODEL_ALIAS:-qwen3-tts}"
    device_args "$backend"
    environment_args
}

run_server() {
    local backend="$1"
    local mode="$2"
    local image
    local -a args
    require_backend "$backend"
    ensure_image "$backend"
    prepare_data
    ensure_models
    image="$(image_for "$backend")"
    mapfile -t args < <(container_args "$backend")
    "$ENGINE" rm --force "$CONTAINER_NAME" >/dev/null 2>&1 || true
    if [[ "$mode" == foreground ]]; then
        exec "$ENGINE" run --rm "${args[@]}" "$image"
    fi
    "$ENGINE" run --detach --restart="$RESTART_POLICY" "${args[@]}" "$image"
    printf 'Qwen3-TTS is starting at http://%s:%s\n' "$BIND_ADDRESS" "$PORT"
}

doctor() {
    local backend="$1"
    require_backend "$backend"
    command -v "$ENGINE" >/dev/null || die "$ENGINE is not installed"
    "$ENGINE" info >/dev/null || die "$ENGINE daemon is not available to this user"
    printf 'engine: %s\nbackend: %s\ndata: %s\n' "$ENGINE" "$backend" "$DATA_DIR"
    if [[ "$backend" == vulkan ]]; then
        [[ -d /dev/dri ]] && printf '/dev/dri: ok\n' || printf '/dev/dri: missing\n'
        [[ -e /dev/dri/renderD128 ]] && printf 'render node: ok\n' || printf 'render node: missing\n'
    fi
    local image
    image="$(image_for "$backend")"
    if "$ENGINE" image inspect "$image" >/dev/null 2>&1; then
        printf 'image: %s\n' "$image"
    else
        printf 'image: not pulled (run qwen3-tts pull %s)\n' "$backend"
    fi
    local model
    for model in "$TALKER_MODEL" "$CODEC_MODEL"; do
        if [[ -f "$DATA_DIR/models/$model" ]]; then
            if verify_model "$DATA_DIR/models/$model"; then
                printf 'model %s: ok\n' "$model"
            else
                printf 'model %s: FAILED sha256 (delete and re-run to re-provision)\n' "$model"
            fi
        else
            printf 'model %s: missing (provisioned on first start)\n' "$model"
        fi
    done
    printf 'note: doctor is a pre-flight check only; GPU inference proof is a separate bounded validation run with kernel log monitoring\n'
}

install_user_service() {
    local backend="$1"
    require_backend "$backend"
    [[ -n "${QWEN3_TTS_EXECUTABLE:-}" ]] || die "run this through the flake: nix run .#qwen3-tts -- install-user $backend"
    local profile="${XDG_STATE_HOME:-$HOME/.local/state}/qwen3-tts/profile"
    mkdir -p "$(dirname "$profile")"
    nix build --out-link "$profile" "$SOURCE_DIR#qwen3-tts"
    local executable="$profile/bin/qwen3-tts"
    local unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    local unit="$unit_dir/qwen3-tts.service"
    mkdir -p "$unit_dir"
    {
        printf '%s\n' '[Unit]' 'Description=Qwen3-TTS service' 'After=network-online.target' 'Wants=network-online.target' \
            'StartLimitIntervalSec=60' 'StartLimitBurst=2'
        printf '\n%s\n' '[Service]' 'Type=simple' "Environment=QWEN_BACKEND=$backend" "Environment=QWEN3_TTS_DATA_DIR=$DATA_DIR"
        printf 'Environment=QWEN_PORT=%s\n' "$PORT"
        printf 'Environment=QWEN_BIND_ADDRESS=%s\n' "$BIND_ADDRESS"
        printf 'Environment=QWEN_CONTAINER_ENGINE=%s\n' "$ENGINE"
        for variable in QWEN_IMAGE QWEN_IMAGE_TAG QWEN_TALKER_MODEL QWEN_CODEC_MODEL \
            TTS_LANG MODEL_ALIAS WARMUP_VOICE WARMUP_MAX_NEW_TOKENS MAX_BATCH MAX_PREFILL_TOKENS \
            CODEC_CHUNK_DUR GGML_VK_ALLOW_GRAPHICS_QUEUE GGML_VK_ASYNC_USE_TRANSFER_QUEUE \
            GGML_VK_SERIALIZE_SUBMISSIONS GGML_VK_DISABLE_F16 RADV_PERFTEST; do
            if [[ -n "${!variable:-}" ]]; then
                [[ "${!variable}" != *$'\n'* ]] || die "$variable cannot contain a newline"
                printf 'Environment=%s=%s\n' "$variable" "${!variable}"
            fi
        done
        printf 'ExecStart=%s serve %s\n' "$executable" "$backend"
        printf 'ExecStop=%s stop\n' "$executable"
        printf '%s\n' 'Restart=on-failure' 'RestartSec=10' 'TimeoutStartSec=infinity'
        printf '\n%s\n' '[Install]' 'WantedBy=default.target'
    } >"$unit"
    systemctl --user daemon-reload
    systemctl --user disable --now qwen3-tts.service >/dev/null 2>&1 || true
    printf 'installed %s (disabled and stopped)\n' "$unit"
    printf 'Start once: systemctl --user start qwen3-tts.service\n'
    printf 'Enable at login only after validation: systemctl --user enable --now qwen3-tts.service\n'
}

uninstall_user_service() {
    local unit="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/qwen3-tts.service"
    local profile="${XDG_STATE_HOME:-$HOME/.local/state}/qwen3-tts/profile"
    systemctl --user disable --now qwen3-tts.service 2>/dev/null || true
    rm -f "$unit"
    rm -f "$profile"
    systemctl --user daemon-reload
    printf 'removed %s and its Nix profile link\n' "$unit"
}

command="${1:-help}"
shift || true

case "$command" in
    pull)
        backend="${1:-$BACKEND}"
        require_backend "$backend"
        ensure_image "$backend"
        ;;
    serve) run_server "${1:-$BACKEND}" foreground ;;
    start) run_server "${1:-$BACKEND}" detached ;;
    stop) "$ENGINE" rm --force "$CONTAINER_NAME" >/dev/null 2>&1 || true ;;
    restart)
        backend="${1:-$BACKEND}"
        "$ENGINE" rm --force "$CONTAINER_NAME" >/dev/null 2>&1 || true
        run_server "$backend" detached
        ;;
    status)
        "$ENGINE" ps --all --filter "name=^/${CONTAINER_NAME}$"
        curl --fail --silent --show-error "http://$BIND_ADDRESS:$PORT/health" | jq . || true
        ;;
    logs) "$ENGINE" logs "$@" "$CONTAINER_NAME" ;;
    doctor) doctor "${1:-$BACKEND}" ;;
    install-user) install_user_service "${1:-$BACKEND}" ;;
    uninstall-user) uninstall_user_service ;;
    voice)
        prepare_data
        exec python3 "$SOURCE_DIR/scripts/voice_manager.py" --directory "$DATA_DIR/voices" "$@"
        ;;
    help|-h|--help) usage ;;
    *) usage >&2; die "unknown command '$command'" ;;
esac
